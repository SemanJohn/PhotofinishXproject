<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Photo Finish Olahraga Realtime</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; }
        body { background-color: #1a1a1a; color: #ffffff; margin: 0; padding: 15px; display: flex; flex-direction: column; align-items: center; }
        h1 { margin-top: 0; color: #00ffcc; font-size: 1.4rem; text-align: center; }
        .container { width: 100%; max-width: 1000px; display: flex; flex-direction: column; gap: 15px; }
        
        .video-box { position: relative; width: 100%; max-width: 640px; margin: 0 auto; background: #000; border: 2px solid #333; border-radius: 8px; overflow: hidden; }
        video { width: 100%; height: auto; display: block; }
        .finish-line-overlay { position: absolute; top: 0; bottom: 0; width: 2px; background-color: red; cursor: ew-resize; z-index: 10; }
        
        .controls { background: #2a2a2a; padding: 15px; border-radius: 8px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; }
        button { padding: 10px 16px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; transition: 0.2s; font-size: 0.9rem; }
        .btn-start { background-color: #28a745; color: white; }
        .btn-start:hover { background-color: #218838; }
        .btn-pause { background-color: #ffc107; color: black; }
        .btn-clear { background-color: #dc3545; color: white; }
        .btn-save { background-color: #17a2b8; color: white; }
        
        .control-group { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        input[type="range"] { accent-color: #00ffcc; }
        
        .timer-display { font-size: 2.2rem; font-family: monospace; font-weight: bold; color: #00ffcc; text-align: center; background: #000; padding: 10px; border-radius: 8px; border: 1px solid #333; }

        .canvas-container { width: 100%; overflow-x: auto; background: #000; border: 2px solid #00ffcc; border-radius: 8px; position: relative; }
        canvas { display: block; background: #111; cursor: crosshair; }
        
        .info-panel { font-size: 0.9rem; color: #ccc; text-align: center; background: #222; padding: 8px; border-radius: 5px; }
        #inspectTime { color: #ffeb3b; font-weight: bold; font-family: monospace; }
    </style>
</head>
<body>

<div class="container">
    <h1>Sistem Photo Finish Olahraga Realtime</h1>
    
    <div class="timer-display" id="timerDisplay">00:00.000</div>

    <!-- Pratonton Kamera & Garisan Penamat -->
    <div class="video-box" id="videoBox">
        <video id="webcam" autoplay playsinline muted></video>
        <div class="finish-line-overlay" id="finishLine" style="left: 50%;"></div>
    </div>

    <!-- Panel Kawalan -->
    <div class="controls">
        <button class="btn-start" id="btnStartTimer">▶ MULA LARIAN (RESET TIMER)</button>
        <button class="btn-pause" id="btnToggleScan">⏸ PAUSE / RESUME</button>
        <button class="btn-clear" id="btnClear">🗑 CLEAR CANVAS</button>
        <button class="btn-save" id="btnSave">💾 SIMPAN GAMBAR</button>
        
        <div class="control-group">
            <label>Kedudukan Garisan (X):</label>
            <input type="range" id="slitPosSlider" min="0" max="100" value="50">
        </div>
        <div class="control-group">
            <label>Lebar Slice:</label>
            <input type="range" id="sliceWidthSlider" min="1" max="5" value="2">
            <span id="sliceWidthVal">2px</span>
        </div>
    </div>

    <div class="info-panel">
        Klik pada imej Photo Finish di bawah untuk menyemak masa tepat pelari: <span id="inspectTime">--:--.---</span>
    </div>

    <!-- Kanvas Photo Finish -->
    <div class="canvas-container" id="canvasScroll">
        <canvas id="photoCanvas" height="400" width="3000"></canvas>
    </div>
</div>

<script>
    const video = document.getElementById('webcam');
    const finishLine = document.getElementById('finishLine');
    const photoCanvas = document.getElementById('photoCanvas');
    const ctx = photoCanvas.getContext('2d');
    const timerDisplay = document.getElementById('timerDisplay');
    const inspectTime = document.getElementById('inspectTime');
    
    const btnStartTimer = document.getElementById('btnStartTimer');
    const btnToggleScan = document.getElementById('btnToggleScan');
    const btnClear = document.getElementById('btnClear');
    const btnSave = document.getElementById('btnSave');
    const slitPosSlider = document.getElementById('slitPosSlider');
    const sliceWidthSlider = document.getElementById('sliceWidthSlider');
    const sliceWidthVal = document.getElementById('sliceWidthVal');
    const canvasScroll = document.getElementById('canvasScroll');

    let isScanning = true;
    let startTime = null;
    let timerInterval = null;
    let currentX = 0;
    let sliceWidth = parseInt(sliceWidthSlider.value);
    let slitPercent = 0.5; // Kedudukan garisan lalai (50%)
    
    // Menyimpan rekod masa (ms) bagi setiap piksel paksi-X canvas
    let timeAtPixel = [];

    // Mengakses Kamera Belakang (Environment)
    async function initCamera() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({
                video: {
                    facingMode: 'environment',
                    width: { ideal: 1280 },
                    height: { ideal: 720 },
                    frameRate: { ideal: 60 }
                },
                audio: false
            });
            video.srcObject = stream;
            video.onloadedmetadata = () => {
                photoCanvas.height = video.videoHeight || 480;
                clearCanvas();
            };
        } catch (err) {
            alert('Gagal mengakses kamera: ' + err.message + '\nSila pastikan anda menggunakan HTTPS atau localhost dan membenarkan kebenaran (permission) kamera.');
        }
    }

    // Melaraskan Garisan Penamat
    slitPosSlider.addEventListener('input', (e) => {
        slitPercent = e.target.value / 100;
        finishLine.style.left = `${e.target.value}%`;
    });

    sliceWidthSlider.addEventListener('input', (e) => {
        sliceWidth = parseInt(e.target.value);
        sliceWidthVal.innerText = `${sliceWidth}px`;
    });

    // Mula Pemasa Larian
    btnStartTimer.addEventListener('click', () => {
        startTime = performance.now();
        currentX = 0;
        timeAtPixel = [];
        clearCanvas();
        
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(updateTimerDisplay, 10);
    });

    function updateTimerDisplay() {
        if (!startTime) return;
        const elapsed = performance.now() - startTime;
        timerDisplay.innerText = formatTime(elapsed);
    }

    function formatTime(ms) {
        if (ms < 0 || isNaN(ms)) return "00:00.000";
        const totalSec = Math.floor(ms / 1000);
        const min = Math.floor(totalSec / 60).toString().padStart(2, '0');
        const sec = (totalSec % 60).toString().padStart(2, '0');
        const milli = Math.floor(ms % 1000).toString().padStart(3, '0');
        return `${min}:${sec}.${milli}`;
    }

    // Membersihkan Canvas
    function clearCanvas() {
        ctx.fillStyle = '#111';
        ctx.fillRect(0, 0, photoCanvas.width, photoCanvas.height);
        currentX = 0;
        timeAtPixel = [];
    }

    btnClear.addEventListener('click', clearCanvas);

    btnToggleScan.addEventListener('click', () => {
        isScanning = !isScanning;
        btnToggleScan.innerText = isScanning ? "⏸ PAUSE" : "▶ RESUME";
    });

    // Gelung Real-Time Slit Scan
    function processFrame() {
        if (isScanning && video.readyState === video.HAVE_ENOUGH_DATA) {
            const videoWidth = video.videoWidth;
            const videoHeight = video.videoHeight;
            const sourceX = Math.floor(videoWidth * slitPercent);

            // Memperluaskan canvas jika melebihi saiz asal
            if (currentX + sliceWidth > photoCanvas.width) {
                expandCanvas();
            }

            // Memotong jalur menegak daripada video dan melukis pada canvas
            ctx.drawImage(
                video,
                sourceX, 0, sliceWidth, videoHeight,
                currentX, 0, sliceWidth, photoCanvas.height
            );

            // Simpan rekod masa bagi jalur ini
            const currentTime = startTime ? (performance.now() - startTime) : 0;
            for (let w = 0; w < sliceWidth; w++) {
                timeAtPixel[currentX + w] = currentTime;
            }

            // Melukis tanda masa pada bahagian bawah
            if (startTime) {
                drawTimeMark(currentX, currentTime);
            }

            currentX += sliceWidth;

            // Auto-scroll kanvas ke kanan mengikut perkembangan larian
            canvasScroll.scrollLeft = currentX;
        }

        requestAnimationFrame(processFrame);
    }

    function expandCanvas() {
        const oldData = ctx.getImageData(0, 0, photoCanvas.width, photoCanvas.height);
        photoCanvas.width += 1000;
        ctx.putImageData(oldData, 0, 0);
    }

    function drawTimeMark(x, elapsedMs) {
        const sec = elapsedMs / 1000;
        if (Math.floor(sec) > Math.floor((elapsedMs - 20) / 1000)) {
            ctx.strokeStyle = 'rgba(255, 0, 0, 0.8)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(x, photoCanvas.height - 25);
            ctx.lineTo(x, photoCanvas.height);
            ctx.stroke();

            ctx.fillStyle = '#00ffcc';
            ctx.font = '10px monospace';
            ctx.fillText(`${Math.floor(sec)}s`, x + 2, photoCanvas.height - 5);
        }
    }

    // Semakan Masa Tempatan Melalui Klik Pada Gambar
    photoCanvas.addEventListener('click', (e) => {
        const rect = photoCanvas.getBoundingClientRect();
        const clickX = Math.floor(e.clientX - rect.left);
        if (timeAtPixel[clickX] !== undefined) {
            inspectTime.innerText = `${formatTime(timeAtPixel[clickX])}`;
        } else {
            inspectTime.innerText = "Tiada rekod masa pada koordinat ini";
        }
    });

    // Simpan Gambar Photo Finish
    btnSave.addEventListener('click', () => {
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = Math.max(currentX, 100);
        exportCanvas.height = photoCanvas.height;
        const exportCtx = exportCanvas.getContext('2d');
        exportCtx.drawImage(photoCanvas, 0, 0, exportCanvas.width, exportCanvas.height, 0, 0, exportCanvas.width, exportCanvas.height);

        const link = document.createElement('a');
        link.download = `photo_finish_${Date.now()}.png`;
        link.href = exportCanvas.toDataURL('image/png');
        link.click();
    });

    initCamera();
    requestAnimationFrame(processFrame);
</script>

</body>
</html>
